<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Tutti i ruoli di colore dell'app. Ogni chiave dice a cosa serve il colore, non che tinta ha.
        Nelle pagine e negli stili non vanno scritti colori: si usa una di queste chiavi.

        Qui i pennelli sono volutamente senza colore: i valori stanno nella palette
        (Theme/Palette.cs) e li scrive Tema.Applica all'avvio. Un pennello nuovo va aggiunto
        qui, in Palette e nella corrispondenza di Services/Tema.cs.
    -->

    <!-- ===== Chiavi di sistema: sovrascrivono risorse di WinUI =====
         Tema.Applica aggiunge qui anche SystemAccentColor. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <!-- Campi di testo (TextBox, NumberBox) -->
            <SolidColorBrush x:Key="TextControlBackground" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" />
            <SolidColorBrush x:Key="TextControlBorderBrush" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" />
            <SolidColorBrush x:Key="TextControlForeground" />
            <SolidColorBrush x:Key="TextControlForegroundPointerOver" />
            <SolidColorBrush x:Key="TextControlForegroundFocused" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ===== Chiavi dell'app ===== -->

    <!-- Sfondi e bordi -->
    <SolidColorBrush x:Key="CanvasBrush" />
    <SolidColorBrush x:Key="SurfaceBrush" />
    <SolidColorBrush x:Key="RaisedSurfaceBrush" />
    <SolidColorBrush x:Key="BorderBrushSubtle" />

    <!-- Testi -->
    <SolidColorBrush x:Key="TextPrimaryBrush" />
    <SolidColorBrush x:Key="SecondaryTextBrush" />
    <SolidColorBrush x:Key="MutedTextBrush" />
    <SolidColorBrush x:Key="AccentTextBrush" />
    <SolidColorBrush x:Key="ErrorTextBrush" />
    <!-- Testo e icone sopra superfici colorate: pulsanti grandi, card dei depositi -->
    <SolidColorBrush x:Key="OnAccentBrush" />

    <!-- Pulsante d'azione principale -->
    <SolidColorBrush x:Key="AccentActionBackground" />
    <SolidColorBrush x:Key="AccentActionPointerOverBrush" />
    <SolidColorBrush x:Key="AccentActionPressedBrush" />
    <SolidColorBrush x:Key="AccentActionDisabledBrush" />
    <SolidColorBrush x:Key="AccentActionDisabledForegroundBrush" />
    <SolidColorBrush x:Key="AccentActionBorder" />
    <SolidColorBrush x:Key="AccentActionForeground" />

    <!-- Azione distruttiva (rimozione di un deposito) -->
    <SolidColorBrush x:Key="DestructiveSurfaceBrush" />
    <SolidColorBrush x:Key="DestructiveBorderBrush" />
    <SolidColorBrush x:Key="DestructiveForegroundBrush" />

    <!-- Grafici -->
    <SolidColorBrush x:Key="ChartGridBrush" />
    <SolidColorBrush x:Key="ChartLabelBrush" />

    <!-- Depositi: toni profondi e terrosi, con contrasto sufficiente per il testo chiaro.
         Assegnati in ordine e riusati ciclicamente oltre l'ottavo. -->
    <SolidColorBrush x:Key="Deposito1Brush" />
    <SolidColorBrush x:Key="Deposito2Brush" />
    <SolidColorBrush x:Key="Deposito3Brush" />
    <SolidColorBrush x:Key="Deposito4Brush" />
    <SolidColorBrush x:Key="Deposito5Brush" />
    <SolidColorBrush x:Key="Deposito6Brush" />
    <SolidColorBrush x:Key="Deposito7Brush" />
    <SolidColorBrush x:Key="Deposito8Brush" />
</ResourceDictionary>
