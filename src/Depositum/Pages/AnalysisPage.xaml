<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Depositum.Pages.AnalysisPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:charts="using:Depositum.Charts"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI">

    <Grid Background="{ThemeResource CanvasBrush}"
          Padding="{StaticResource PageEdgePaddingVertical}"
          RowSpacing="{StaticResource StandardElementSpacing}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="{StaticResource PageEdgeMarginHorizontal}">
            <TextBlock Text="DEPOSITUM" Style="{StaticResource TitleSerifStyle}"
                       HorizontalAlignment="Left" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Width="34" Height="34" MinWidth="0" MinHeight="0" Padding="0"
                        Style="{StaticResource BaseDarkButtonStyle}"
                        Click="BtnIndietro_Click" AutomationProperties.Name="Torna alla dashboard">
                    <FontIcon Glyph="&#xF15C;" Style="{StaticResource ButtonIconStyle}" />
                </Button>
                <Button x:Name="BtnOpzioni" Width="32" Height="32" MinWidth="0" MinHeight="0" Padding="0"
                        Style="{StaticResource BaseDarkButtonStyle}"
                        Click="BtnOpzioni_Click" AutomationProperties.Name="Opzioni del grafico">
                    <FontIcon Glyph="&#xF557;" Style="{StaticResource ButtonIconStyle}" />
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="{StaticResource PageEdgeMarginHorizontal}"
                Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource BorderBrushSubtle}" BorderThickness="1"
                CornerRadius="10" Padding="16">
            <Grid>
                <lvc:CartesianChart x:Name="CartesianChart" Visibility="Collapsed" />
                <lvc:PieChart x:Name="PieChart" Visibility="Collapsed" />
                <TextBlock x:Name="TxtCanvasVuoto" Text="Nessun dato da visualizzare"
                           Foreground="{ThemeResource MutedTextBrush}" FontSize="15"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="{StaticResource PageEdgeMarginHorizontal}"
              ColumnSpacing="{StaticResource StandardElementSpacing}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnIstogramma" Grid.Column="0" Click="BtnGrafico_Click"
                    Tag="{x:Bind charts:TipoGrafico.Istogramma}" Style="{StaticResource BigActionButtonStyle}" Height="54" Padding="8,0">
                <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xF342;" Style="{StaticResource ButtonIconStyle}" />
                    <TextBlock Text="Istogramma" Style="{StaticResource SmallButtonLabelStyle}" />
                </StackPanel>
            </Button>
            <Button x:Name="BtnLinee" Grid.Column="1" Click="BtnGrafico_Click"
                    Tag="{x:Bind charts:TipoGrafico.Linee}" Style="{StaticResource BigActionButtonStyle}" Height="54" Padding="8,0">
                <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xF343;" Style="{StaticResource ButtonIconStyle}" />
                    <TextBlock Text="Linee" Style="{StaticResource SmallButtonLabelStyle}" />
                </StackPanel>
            </Button>
            <Button x:Name="BtnRadiale" Grid.Column="2" Click="BtnGrafico_Click"
                    Tag="{x:Bind charts:TipoGrafico.Radiale}" Style="{StaticResource BigActionButtonStyle}" Height="54" Padding="8,0">
                <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xF345;" Style="{StaticResource ButtonIconStyle}" />
                    <TextBlock Text="Radiale" Style="{StaticResource SmallButtonLabelStyle}" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
