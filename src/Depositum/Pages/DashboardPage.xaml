<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Depositum.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Depositum">

    <Grid Background="{ThemeResource CanvasBrush}" 
          Padding="{StaticResource PageEdgePaddingVertical}" 
          RowSpacing="{StaticResource StandardElementSpacing}">
        <Grid.RowDefinitions>
            <!-- Riga 0: Header (Titolo DEPOSITUM e Data) -->
            <RowDefinition Height="Auto" />
            <!-- Riga 1: Area Depositi (2 colonne con scroll in caso di molti elementi) -->
            <RowDefinition Height="*" />
            <!-- Riga 2: Rilevazione Totale -->
            <RowDefinition Height="Auto" />
            <!-- Riga 3: Pulsanti sul fondo -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER: DEPOSITUM a sinistra, Data a destra -->
        <Grid Grid.Row="0" Margin="{StaticResource PageEdgeMarginHorizontal}">
            <TextBlock Text="DEPOSITUM" 
                       Style="{StaticResource TitleSerifStyle}" 
                       HorizontalAlignment="Left" />

            <TextBlock x:Name="TxtDataHeader" 
                       Text="00/00/0000" 
                       Style="{StaticResource HeaderDateStyle}" 
                       HorizontalAlignment="Right" />
        </Grid>

        <!-- AREA DEPOSITI: ScrollViewer a tutta larghezza per barra di scorrimento sul bordo finestra -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="{StaticResource ScrollViewerContentPadding}">
            <Grid>
                <!-- Stato vuoto se non è presente alcun deposito -->
                <StackPanel x:Name="EmptyStateContainer" 
                            Spacing="8" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center" 
                            Margin="0, 60, 0, 60"
                            Visibility="Collapsed">
                    <TextBlock Text="Nessun Deposito" 
                               FontSize="20" 
                               FontWeight="SemiBold" 
                               Foreground="{ThemeResource SecondaryTextBrush}" 
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Premi 'Registra Depositi' per creare la prima rilevazione." 
                               FontSize="13" 
                               Foreground="{ThemeResource MutedTextBrush}" 
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Card dei depositi su 2 colonne di pari larghezza -->
                <ItemsRepeater x:Name="DepositiRepeater">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MaximumRowsOrColumns="2"
                                           MinItemWidth="100"
                                           MinItemHeight="88"
                                           MinColumnSpacing="{StaticResource StandardElementSpacing}"
                                           MinRowSpacing="{StaticResource StandardElementSpacing}"
                                           ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="local:DepositoCard">
                            <Border Height="88"
                                    CornerRadius="12"
                                    Background="{x:Bind Sfondo}"
                                    Padding="14,10,14,10">
                                <Grid>
                                    <TextBlock Text="{x:Bind Nome}" Style="{StaticResource DepositCardNameStyle}" />
                                    <TextBlock Text="{x:Bind Importo}" Style="{StaticResource DepositCardAmountStyle}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Grid>
        </ScrollViewer>

        <!-- SEZIONE TOTALE: Subito prima dei pulsanti -->
        <Grid Grid.Row="2" Margin="{StaticResource PageEdgeMarginHorizontal}">
            <TextBlock Text="Totale:" 
                       Style="{StaticResource FieldLabelStyle}"
                       FontSize="20"
                       HorizontalAlignment="Left" />

            <TextBlock x:Name="TxtTotaleValore" 
                       Text="0€" 
                       Style="{StaticResource AmountStyle}" 
                       HorizontalAlignment="Right" />
        </Grid>

        <!-- PULSANTI SUL FONDO -->
        <StackPanel Grid.Row="3" 
                    Spacing="{StaticResource StandardElementSpacing}" 
                    Margin="{StaticResource PageEdgeMarginHorizontal}">
            <!-- Pulsante 1: Registra Depositi -->
            <Button x:Name="BtnRegistraDepositi"
                    Click="BtnRegistraDepositi_Click"
                    Style="{StaticResource PrimaryAccentButtonStyle}"
                    Height="56"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Padding="18,0">
                <Grid HorizontalAlignment="Stretch" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Registra depositi" Style="{StaticResource BigButtonLabelStyle}" />
                    <FontIcon Grid.Column="1" Glyph="&#xF10A;" Style="{StaticResource BigButtonIconStyle}" />
                </Grid>
            </Button>

            <!-- Pulsante 2: Osserva nel tempo -->
            <Button x:Name="BtnOsservaNelTempo"
                    Click="BtnOsservaNelTempo_Click"
                    Style="{StaticResource BigActionButtonStyle}">
                <Grid HorizontalAlignment="Stretch">
                    <TextBlock Text="Osserva nel tempo" Style="{StaticResource BigButtonLabelStyle}" />
                    <FontIcon Glyph="&#xE45E;" Style="{StaticResource BigButtonIconStyle}" />
                </Grid>
            </Button>
        </StackPanel>

    </Grid>
</Page>
