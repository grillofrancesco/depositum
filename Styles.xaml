<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ======================================================== -->
    <!-- OVERRIDE RISORSE TEMA (Elimina il flickering chiaro)     -->
    <!-- In WinUI 3 i pennelli di stato si sovrascrivono tramite  -->
    <!-- ThemeDictionaries a livello di ResourceDictionary        -->
    <!-- ======================================================== -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <!-- Pulsanti: colori normali, hover e press scuri senza flash bianco -->
            <SolidColorBrush x:Key="ButtonBackground" Color="#1E1E1E" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2A2A2A" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#161616" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#141414" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#333333" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#444444" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#222222" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#222222" />
            <SolidColorBrush x:Key="ButtonForeground" Color="White" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#DDDDDD" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#555555" />

            <!-- Input (TextBox): colori scuri per hover e focus -->
            <SolidColorBrush x:Key="TextControlBackground" Color="#1E1E1E" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#262626" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#222222" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#333333" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#444444" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="TextControlForeground" Color="White" />
            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="White" />
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="White" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#888888" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#AAAAAA" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#666666" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <!-- Pulsanti in Dark Theme -->
            <SolidColorBrush x:Key="ButtonBackground" Color="#1E1E1E" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2A2A2A" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#161616" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#141414" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#333333" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#444444" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#222222" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#222222" />
            <SolidColorBrush x:Key="ButtonForeground" Color="White" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#DDDDDD" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#555555" />

            <!-- Input in Dark Theme -->
            <SolidColorBrush x:Key="TextControlBackground" Color="#1E1E1E" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#262626" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#222222" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#333333" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#444444" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="TextControlForeground" Color="White" />
            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="White" />
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="White" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#888888" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#AAAAAA" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#666666" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>


    <!-- ======================================================== -->
    <!-- 1. STILI PULSANTI (BUTTONS)                              -->
    <!-- ======================================================== -->

    <!-- Stile base per tutti i pulsanti scuri -->
    <Style x:Key="BaseDarkButtonStyle" TargetType="Button">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="#1E1E1E" />
        <Setter Property="BorderBrush" Value="#333333" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Stile implicito per ogni Button nell'applicazione -->
    <Style TargetType="Button" BasedOn="{StaticResource BaseDarkButtonStyle}" />

    <!-- Stile per i grandi pulsanti di azione (Dashboard: Registra, Osserva) -->
    <Style x:Key="BigActionButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseDarkButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Height" Value="54" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="18, 0" />
    </Style>

    <!-- Stile per pulsanti di azione secondaria (es. Annulla) -->
    <Style x:Key="SecondaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseDarkButtonStyle}">
        <Setter Property="Height" Value="48" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Foreground" Value="#CCCCCC" />
    </Style>

    <!-- Stile per pulsante primario / conferma con colore di accento -->
    <Style x:Key="PrimaryAccentButtonStyle" TargetType="Button">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Height" Value="48" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Stile per il pulsante piccolo di rimozione ('-') -->
    <Style x:Key="RemoveItemButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="#1C1C1C" />
        <Setter Property="BorderBrush" Value="#262626" />
        <Setter Property="Foreground" Value="White" />
    </Style>


    <!-- ======================================================== -->
    <!-- 2. STILI BLOCCHI DI TESTO (TEXTBLOCKS)                   -->
    <!-- ======================================================== -->

    <!-- Stile per i titoli principali in stile bancario / romano antico -->
    <Style x:Key="TitleSerifStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Constantia, Georgia, Times New Roman" />
        <Setter Property="FontSize" Value="29" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="80" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Stile per i sottotitoli delle pagine (es. Registra Valori) -->
    <Style x:Key="SubtitleSerifStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Constantia, Georgia, Times New Roman" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="60" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Stile per la data nell'header -->
    <Style x:Key="HeaderDateStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Constantia, Georgia, Segoe UI" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Stile per etichette di campo (es. 'Data:', 'Totale:') -->
    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Constantia, Georgia, Segoe UI" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#E6E6E6" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>


    <!-- ======================================================== -->
    <!-- 3. STILI BLOCCHI DI INPUT (TEXTBOX & NUMBERBOX)          -->
    <!-- ======================================================== -->

    <!-- Stile di default per tutti i TextBox -->
    <Style TargetType="TextBox">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="#1E1E1E" />
        <Setter Property="BorderBrush" Value="#333333" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Stile di default per tutti i NumberBox -->
    <Style TargetType="NumberBox">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="#262626" />
        <Setter Property="BorderBrush" Value="#3A3A3A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SpinButtonPlacementMode" Value="Hidden" />
    </Style>

</ResourceDictionary>
