<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="codebase.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:codebase"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#121212" Padding="0, 30, 0, 30">
        <Grid.RowDefinitions>
            <!-- Riga 0: Header (Titolo DEPOSITUM e Data) -->
            <RowDefinition Height="Auto" />
            <!-- Riga 1: Area Depositi (2 colonne con scroll in caso di molti elementi) -->
            <RowDefinition Height="*" />
            <!-- Riga 2: Rilevazione Totale -->
            <RowDefinition Height="Auto" />
            <!-- Riga 3: Pulsanti sul fondo -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER: DEPOSITUM a sinistra, Data a destra -->
        <Grid Grid.Row="0" Padding="30, 0, 30, 10">
            <TextBlock Text="DEPOSITUM" 
                       FontFamily="Constantia, Georgia, Times New Roman" 
                       FontSize="29" 
                       FontWeight="Bold" 
                       CharacterSpacing="80"
                       Foreground="White" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Left" />

            <TextBlock x:Name="TxtDataHeader" 
                       Text="00/00/0000" 
                       FontFamily="Constantia, Georgia, Segoe UI" 
                       FontSize="20" 
                       FontWeight="SemiBold"
                       Foreground="White" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Right" />
        </Grid>

        <!-- AREA DEPOSITI: Griglia a 2 colonne o messaggio stato vuoto -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="30, 0, 30, 0">
            <Grid>
                <!-- Stato vuoto se non è presente alcun deposito -->
                <StackPanel x:Name="EmptyStateContainer" 
                            Spacing="8" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center" 
                            Margin="0, 60, 0, 60"
                            Visibility="Collapsed">
                    <TextBlock Text="Nessun Deposito" 
                               FontSize="20" 
                               FontWeight="SemiBold" 
                               Foreground="#888888" 
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Premi 'Registra Depositi' per creare la prima rilevazione." 
                               FontSize="13" 
                               Foreground="#555555" 
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Griglia dei depositi popolata dinamicamente a 2 colonne -->
                <Grid x:Name="DepositiGrid" ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- SEZIONE TOTALE: Subito prima dei pulsanti -->
        <Grid Grid.Row="2" Margin="30,15,30,15">
            <TextBlock Text="Totale:" 
                       FontSize="20" 
                       FontFamily="Constantia, Georgia, Segoe UI"
                       FontWeight="SemiBold" 
                       Foreground="#E6E6E6" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Left" />

            <TextBlock x:Name="TxtTotaleValore" 
                       Text="0€" 
                       FontSize="24" 
                       FontFamily="Constantia, Georgia, Segoe UI"
                       FontWeight="Bold" 
                       Foreground="White" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Right" />
        </Grid>

        <!-- PULSANTI SUL FONDO -->
        <StackPanel Grid.Row="3" Spacing="10" Padding="30, 0, 30, 0">
            <!-- Pulsante 1: Registra Depositi -->
            <Button x:Name="BtnRegistraDepositi"
                    Click="BtnRegistraDepositi_Click"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Height="54"
                    CornerRadius="10"
                    Background="#1E1E1E"
                    BorderBrush="#333333"
                    BorderThickness="1"
                    Padding="18, 0">
                <Grid HorizontalAlignment="Stretch">
                    <TextBlock Text="Registra Depositi" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Foreground="White" 
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Left" />
                    <FontIcon Glyph="&#xE896;" 
                              FontSize="18" 
                              Foreground="White" 
                              VerticalAlignment="Center" 
                              HorizontalAlignment="Right" />
                </Grid>
            </Button>

            <!-- Pulsante 2: Osserva nel tempo -->
            <Button x:Name="BtnOsservaNelTempo"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Height="54"
                    CornerRadius="10"
                    Background="#1E1E1E"
                    BorderBrush="#333333"
                    BorderThickness="1"
                    Padding="18, 0">
                <Grid HorizontalAlignment="Stretch">
                    <TextBlock Text="Osserva nel tempo" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Foreground="White" 
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Left" />
                    <FontIcon Glyph="&#xE735;" 
                              FontSize="18" 
                              Foreground="White" 
                              VerticalAlignment="Center" 
                              HorizontalAlignment="Right" />
                </Grid>
            </Button>
        </StackPanel>

    </Grid>
</Page>
