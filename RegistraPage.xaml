<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="codebase.RegistraPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:codebase"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#121212" 
          Padding="{StaticResource PageEdgePaddingVertical}" 
          RowSpacing="{StaticResource StandardElementSpacing}">
        <Grid.RowDefinitions>
            <!-- Riga 0: Header (Titolo) -->
            <RowDefinition Height="Auto" />
            <!-- Riga 1: Lista depositi (scrollabile) -->
            <RowDefinition Height="*" />
            <!-- Riga 2: Campo Data -->
            <RowDefinition Height="Auto" />
            <!-- Riga 3: Pulsante Aggiungi Deposito -->
            <RowDefinition Height="Auto" />
            <!-- Riga 4: Tasti Annulla / Conferma -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="{StaticResource PageEdgeMarginHorizontal}">
            <TextBlock Text="Registra Valori" 
                       Style="{StaticResource SubtitleSerifStyle}" 
                       HorizontalAlignment="Left" />
        </Grid>

        <!-- LISTA DEPOSITI: ScrollViewer a tutta larghezza per barra di scorrimento sul bordo finestra -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="{StaticResource ScrollViewerContentPadding}">
            <StackPanel Spacing="{StaticResource StandardElementSpacing}">
                <!-- InfoBar in caso di errori di validazione -->
                <InfoBar x:Name="StatusInfoBar" IsOpen="False" Severity="Warning"  />

                <!-- Lista Items -->
                <ItemsControl x:Name="ItemsDepositi">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="{StaticResource StandardElementSpacing}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:DepositoEditItem">
                            <Border Background="#1C1C1C" 
                                    BorderBrush="#2C2C2C" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Padding="14, 8">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Nome deposito a sinistra -->
                                    <TextBlock Text="{x:Bind Nome}" 
                                               FontSize="15" 
                                               FontWeight="SemiBold" 
                                               Foreground="White" 
                                               VerticalAlignment="Center" 
                                               TextTrimming="CharacterEllipsis" />

                                    <!-- Input numerico per il valore -->
                                    <NumberBox Grid.Column="1" 
                                               Value="{x:Bind Valore, Mode=OneWay}"
                                               ValueChanged="NumberBoxValore_ValueChanged"
                                               AcceptsExpression="False"
                                               Width="80" 
                                               Height="36" 
                                               Margin="12, 0, 8, 0" 
                                               VerticalAlignment="Center" />

                                    <!-- Pulsante '-' per rimuovere -->
                                    <Button Grid.Column="2" 
                                            Content="-" 
                                            Click="BtnRimuovi_Click" 
                                            Tag="{x:Bind}" 
                                            Style="{StaticResource RemoveItemButtonStyle}" 
                                            VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- CAMPO DATA SEMPLICE: Testo a sinistra, Box all'estrema destra -->
        <Grid Grid.Row="2" Margin="{StaticResource PageEdgeMarginHorizontal}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Data:" 
               Style="{StaticResource FieldLabelStyle}" 
               HorizontalAlignment="Left" />

            <TextBox x:Name="TxtDataInput" 
             Grid.Column="1" 
             PlaceholderText="gg/mm/aaaa" 
             Width="140"
             HorizontalAlignment="Right"
             HorizontalContentAlignment="Center" />
        </Grid>

        <!-- PULSANTE AGGIUNGI DEPOSITO -->
        <Grid Grid.Row="3" Margin="{StaticResource PageEdgeMarginHorizontal}">
            <Button x:Name="BtnAggiungiDeposito" 
                    Click="BtnAggiungiDeposito_Click" 
                    HorizontalAlignment="Stretch" 
                    Height="44">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE710;" FontSize="14" Foreground="White" />
                    <TextBlock Text="Aggiungi Deposito" FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- COPPIA TASTI CONFERMA / ANNULLA -->
        <Grid Grid.Row="4" 
              ColumnSpacing="{StaticResource StandardElementSpacing}" 
              Margin="{StaticResource PageEdgeMarginHorizontal}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnAnnulla" 
                    Grid.Column="0" 
                    Content="Annulla" 
                    Click="BtnAnnulla_Click" 
                    Style="{StaticResource SecondaryActionButtonStyle}" 
                    HorizontalAlignment="Stretch" />

            <Button x:Name="BtnConferma" 
                    Grid.Column="1" 
                    Content="Conferma" 
                    Click="BtnConferma_Click" 
                    Style="{StaticResource PrimaryAccentButtonStyle}" 
                    HorizontalAlignment="Stretch" />
        </Grid>

    </Grid>
</Page>
