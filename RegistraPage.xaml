<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="codebase.RegistraPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:codebase"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#121212" Padding="0, 30, 0, 30">
        <Grid.RowDefinitions>
            <!-- Riga 0: Header (Titolo) -->
            <RowDefinition Height="Auto" />
            <!-- Riga 1: Campo Data -->
            <RowDefinition Height="Auto" />
            <!-- Riga 2: Lista depositi (scrollabile) -->
            <RowDefinition Height="*" />
            <!-- Riga 3: Pulsante Aggiungi Deposito -->
            <RowDefinition Height="Auto" />
            <!-- Riga 4: Tasti Annulla / Conferma -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Padding="30, 0, 30, 0">
            <TextBlock Text="Registra Valori" 
                       FontFamily="Constantia, Georgia, Times New Roman" 
                       FontSize="26" 
                       FontWeight="Bold" 
                       CharacterSpacing="60"
                       Foreground="White" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Left" />
        </Grid>

        <!-- CAMPO DATA SEMPLICE: Testo a sinistra, Box all'estrema destra con larghezza strettamente necessaria -->
        <Grid Grid.Row="1" Padding="30, 0, 30, 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Data:" 
                       FontFamily="Constantia, Georgia, Segoe UI"
                       FontSize="16" 
                       FontWeight="SemiBold" 
                       Foreground="#E6E6E6" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Left" />
            
            <TextBox x:Name="TxtDataInput" 
                     Grid.Column="1" 
                     PlaceholderText="gg/mm/aaaa" 
                     Width="140"
                     CornerRadius="8" 
                     Background="#1E1E1E" 
                     BorderBrush="#333333" 
                     Foreground="White" 
                     FontSize="15" 
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center"
                     HorizontalContentAlignment="Center" />
        </Grid>

        <!-- LISTA DEPOSITI CON NOME, INPUT NUMERICO E TASTO '-' -->
        <ScrollViewer Grid.Row="2" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="30, 0, 30, 0">
            <StackPanel Spacing="8">
                <!-- InfoBar in caso di errori di validazione -->
                <InfoBar x:Name="StatusInfoBar" IsOpen="False" Severity="Warning" Margin="0,0,0,6" Padding="5,5,5,5" />

                <!-- Lista Items -->
                <ItemsControl x:Name="ItemsDepositi">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:DepositoEditItem">
                            <Border Background="#1C1C1C" 
                                    BorderBrush="#2C2C2C" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Padding="14, 8" 
                                    Margin="0, 0, 0, 8">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Nome deposito a sinistra -->
                                    <TextBlock Text="{x:Bind Nome}" 
                                               FontSize="15" 
                                               FontWeight="SemiBold" 
                                               Foreground="White" 
                                               VerticalAlignment="Center" 
                                               TextTrimming="CharacterEllipsis" />

                                    <!-- Input numerico per il valore con testo allineato a destra -->
                                    <NumberBox Grid.Column="1" 
                                               Value="{x:Bind Valore, Mode=TwoWay}" 
                                               SpinButtonPlacementMode="Hidden" 
                                               Width="80" 
                                               Height="36" 
                                               CornerRadius="6" 
                                               Background="#262626" 
                                               BorderBrush="#3A3A3A" 
                                               Foreground="White" 
                                               FontSize="15" 
                                               HorizontalContentAlignment="Right"
                                               Margin="12, 0, 8, 0" 
                                               VerticalAlignment="Center" />

                                    <!-- Pulsante '-' per rimuovere -->
                                    <Button Grid.Column="2" 
                                            Content="-" 
                                            Click="BtnRimuovi_Click" 
                                            Tag="{x:Bind}" 
                                            Width="36" 
                                            Height="36" 
                                            CornerRadius="6" 
                                            Background="#1c1c1c" 
                                            Foreground="White" 
                                            BorderBrush="#262626" 
                                            FontWeight="Bold" 
                                            FontSize="18" 
                                            Padding="0" 
                                            VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- PULSANTE AGGIUNGI DEPOSITO -->
        <Grid Grid.Row="3" Padding="30, 10, 30, 10">
            <Button x:Name="BtnAggiungiDeposito" 
                    Click="BtnAggiungiDeposito_Click" 
                    HorizontalAlignment="Stretch" 
                    Height="44" 
                    CornerRadius="8" 
                    Background="#1E1E1E" 
                    BorderBrush="#333333" 
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE710;" FontSize="14" Foreground="White" />
                    <TextBlock Text="Aggiungi Deposito" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- COPPIA TASTI CONFERMA / ANNULLA -->
        <Grid Grid.Row="4" ColumnSpacing="12" Padding="30, 10, 30, 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnAnnulla" 
                    Grid.Column="0" 
                    Content="Annulla" 
                    Click="BtnAnnulla_Click" 
                    HorizontalAlignment="Stretch" 
                    Height="48" 
                    CornerRadius="10" 
                    Background="#1E1E1E" 
                    BorderBrush="#333333" 
                    BorderThickness="1" 
                    Foreground="#CCCCCC" 
                    FontSize="15" 
                    FontWeight="SemiBold" />

            <Button x:Name="BtnConferma" 
                    Grid.Column="1" 
                    Content="Conferma" 
                    Click="BtnConferma_Click" 
                    HorizontalAlignment="Stretch" 
                    Height="48" 
                    CornerRadius="10" 
                    Background="{ThemeResource AccentFillColorDefaultBrush}" 
                    Foreground="White" 
                    FontSize="15" 
                    FontWeight="Bold" />
        </Grid>

    </Grid>
</Page>
